# SQLite Database file location
DB_PATH=data/routine_doctor.sqlite3

# Allowed CORS frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# Canonical public URL (used for RFC 9728 PRM and OAuth discovery metadata)
PUBLIC_BASE_URL=http://localhost:8000

# MCP streamable-http JSON response flag (0 = SSE streaming, 1 = JSON response)
MCP_JSON_RESPONSE=0

# Alexa+ MCP OAuth 2.1 PKCE enforcement toggle (0 = disabled for dev, 1 = enforce Bearer tokens on /mcp)
AUTH_ENABLED=0
